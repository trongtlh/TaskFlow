{
  "name": "taskflow-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Personal task manager — Vue, Electron, Python and optional Firebase backup",
  "author": "Taskflow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "python -m unittest discover -s backend/tests -v",
    "build:python": "python -m PyInstaller --noconfirm --clean --onedir --name taskflow-api --distpath backend-dist backend/server.py",
    "dist:win": "npm run build && npm run build:python && electron-builder --win nsis",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-taskflow \"node scripts/test-firebase.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "google-auth-library": "^11.1.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "firebase-tools": "^15.32.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.taskflow.desktop.v021",
    "productName": "Taskflow 0.2.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/taskflow-api",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}

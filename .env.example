# Required Firebase Web Config (public client identifiers, NOT Admin/service-account credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# SMTP for the cloud job belongs in Firebase Secret Manager: SMTP_CONFIG.
# Do not put SMTP passwords or Admin keys in VITE_ variables.
